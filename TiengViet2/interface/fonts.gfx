#H = { 253 169 38 }	Màu cam cho tooltip
#color = 0xffffffff	#định dạng là 0xaarrggbb
#G = { 41 225 38 255 } #định dạng là đỏ lục lam alpha
#textcolors = {} có hiệu lực toàn bộ trò chơi cho mọi phông chữ. thay đổi ở một phông sẽ áp dụng cho tất cả các phông khác

bitmapfonts = {
	
	# Màu sắc toàn cục
	textcolors = {
		M = { 163 53 238 }	# M = Đỏ tươi (Magenta). Dấu hiệu cho "Công nghệ Hiếm".
		L = { 195 176 145 }	# L = Văn bản cốt truyện, không ảnh hưởng tới trò chơi, chỉ là thông tin bên lề cho vui.
		G = { 41 225 38 }	# G = Xanh lục (Green), dùng cho các chỉ số có lợi.
		R = { 252 86 70 }	# R = Đỏ (Red), dùng cho các chỉ số bất lợi hoặc cảnh báo.
		B = { 51 167 255 }	# B = Xanh lam (Blue), dùng cho các trường hợp văn bản đặc biệt.
		Y = { 247 252 52 }	# Y = Vàng (Yellow), dùng cho những thứ chưa tối ưu hoặc cần làm nổi bật.
		H = { 251 170 41 }	# H = Làm nổi bật (Highlight), màu cam trong game.
		C = { 31 224 202 }	# C = Xanh lơ (Cyan), dùng cho Văn bản Khái niệm có tạo thêm tooltip mới.
		K = { 251 170 41 }	# K = Tiêu đề cho Khái niệm. Hiện tại giống hệt H.
		I = { 247 252 52 }	# I = Làm nổi bật cho Khái niệm. Hiện tại giống hệt Y.
		T = { 255 255 255 }	# T = Văn bản (Text), tiêu chuẩn cho mọi văn bản, dùng khi TOÀN BỘ văn bản cần tinh chỉnh.
		t = { 198 198 198 } # t = Chữ tooltip của Khái niệm sẽ được bọc trong màu này trên giao diện. Xám nhạt.
		E = { 135 255 207 }	# E = Xanh lục tiêu chuẩn, dùng cho các đoạn văn bản dài, như sự kiện hoặc cố vấn.
		S = { 228 156 42 }	# S = Làm nổi bật phụ đề (trong trường hợp này là màu xanh lục nhạt).
		W = { 255 255 255 }	# W = Trắng (White).
		P = { 225 110 110 }	# P = Hồng (Pink), dùng cho các cảnh báo nhẹ nhàng hơn thay vì dùng §R.
		V = { 76 138 113 }	# V = Xanh lục thẫm, dùng cho văn bản sự kiện.
		g = { 128 128 128 }	# g = Xám (Grey).
		_ = { 255 0 255 }	# _ Đỏ tươi giữ chỗ, dùng cho các đoạn văn bản giữ chỗ.
		U = { 204 179 255 } # U = Tím nhạt (Mauve), dùng cho thẻ khủng hoảng
		
		# Màu Độ hiếm Đặc điểm
		c = { 60 208 146 }
		v = { 139 174 162 }
		d = { 255 221 122 }
	
		# Màu Độ hiếm Lãnh đạo
		r = { 163 130 255 }
		l = { 178 236 104 }
		
		# Màu Độ hiếm
		0 = { 31 224 202 }
		1 = { 51 167 255 }
		2 = { 163 53 238 }
		3 = { 251 170 41 }
	}

